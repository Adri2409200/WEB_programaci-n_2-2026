@page
@model Web_razor_tarea.Pages.Mascotas.CreateModel
@{
    ViewData["Title"] = "Nueva Mascota";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-menta me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-plus-circle-fill me-2"></i>Nueva Mascota
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header mascotas py-2">
                <small class="fw-semibold">Completa los datos de la mascota</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Mascota.PropietarioId" class="form-label"></label>
                        <select asp-for="Mascota.PropietarioId"
                                asp-items="Model.PropietariosLista"
                                class="form-select">
                            <option value="">-- Selecciona un propietario --</option>
                        </select>
                        <span asp-validation-for="Mascota.PropietarioId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.Nombre" class="form-label"></label>
                        <input asp-for="Mascota.Nombre" class="form-control" placeholder="Ej: Luna" />
                        <span asp-validation-for="Mascota.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="Mascota.Especie" class="form-label"></label>
                            <input asp-for="Mascota.Especie" class="form-control" placeholder="Ej: Perro" />
                            <span asp-validation-for="Mascota.Especie" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Mascota.Raza" class="form-label"></label>
                            <input asp-for="Mascota.Raza" class="form-control" placeholder="Ej: Labrador" />
                            <span asp-validation-for="Mascota.Raza" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mascota.FechaNacimiento" class="form-label"></label>
                        <input asp-for="Mascota.FechaNacimiento" class="form-control" type="date" />
                        <span asp-validation-for="Mascota.FechaNacimiento" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Mascota.Activo" class="form-check-input" />
                            <label asp-for="Mascota.Activo" class="form-check-label">Activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-pastel-menta">
                            <i class="bi bi-floppy-fill me-1"></i>Guardar
                        </button>
                        <a asp-page="Index" class="btn btn-pastel-rosa">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
