@page
@model Web_razor_tarea.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-emoji-smile-fill me-2"></i>Mascotas
    </h2>
    <a asp-page="Create" class="btn btn-pastel-menta">
        <i class="bi bi-plus-circle-fill me-1"></i>Nueva Mascota
    </a>
</div>

<!-- Buscador -->
<form method="get" class="mb-3">
    <div class="input-group">
        <span class="input-group-text" style="background:var(--menta-claro); border-color:var(--menta);">
            <i class="bi bi-search" style="color:var(--texto-suave);"></i>
        </span>
        <input type="text" name="Busqueda" value="@Model.Busqueda"
               class="form-control" placeholder="Buscar por nombre, especie, raza o propietario..." />
        <button type="submit" class="btn btn-pastel-menta">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            <a asp-page="Index" class="btn btn-pastel-rosa">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>

<div class="card">
    <div class="card-header mascotas py-2 d-flex justify-content-between align-items-center">
        <small class="fw-semibold">Lista de mascotas registradas</small>
        <small class="text-muted">@Model.Mascotas.Count resultado(s)</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-pastel table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Especie</th>
                        <th>Raza</th>
                        <th>Fecha Nac.</th>
                        <th>Propietario</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Mascotas)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Especie</td>
                            <td>@item.Raza</td>
                            <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>@item.Propietario?.Nombre @item.Propietario?.Apellidos</td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge badge-activo rounded-pill px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo rounded-pill px-3">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-page="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-cielo me-1" title="Ver detalle">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-menta me-1" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-rosa" title="Eliminar">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Mascotas.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No se encontraron mascotas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
