<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veterinaria El Arca de Moe</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web_razor_tarea.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

@{
    // Detecta la sección activa según la ruta de la página actual
    var pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

    <!-- Barra de navegación -->
    <header>
        <nav class="navbar navbar-expand-md navbar-veterinaria">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <i class="bi bi-heart-pulse-fill fs-4"></i>
                    El Arca de Moe
                </a>

                <!-- Botón colapso móvil -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto gap-1">

                        <li class="nav-item">
                            <a class="nav-link @(pagina == "/Index" ? "active" : "")"
                               asp-page="/Index">
                                <i class="bi bi-house-heart-fill me-1"></i>Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(pagina.StartsWith("/Propietarios") ? "active" : "")"
                               asp-page="/Propietarios/Index">
                                <i class="bi bi-people-fill me-1"></i>Propietarios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(pagina.StartsWith("/Mascotas") ? "active" : "")"
                               asp-page="/Mascotas/Index">
                                <i class="bi bi-emoji-smile-fill me-1"></i>Mascotas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(pagina.StartsWith("/Veterinarios") ? "active" : "")"
                               asp-page="/Veterinarios/Index">
                                <i class="bi bi-person-badge-fill me-1"></i>Veterinarios
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(pagina.StartsWith("/Citas") ? "active" : "")"
                               asp-page="/Citas/Index">
                                <i class="bi bi-calendar2-heart-fill me-1"></i>Citas
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <div class="container">
        <div class="container-main">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Pie de página -->
    <footer class="footer-veterinaria fixed-bottom">
        <div class="container text-center">
            <i class="bi bi-heart-fill me-1" style="color:#c9b8e8;"></i>
            &copy; 2026 Veterinaria El Arca de Moe &mdash; Todos los derechos reservados
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
