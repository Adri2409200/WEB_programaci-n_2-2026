@page
@model Web_razor_tarea.Pages.Citas.EditModel
@using Web_razor_tarea.Models
@{
    ViewData["Title"] = "Editar Cita";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-rosa me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-pencil-fill me-2"></i>Editar Cita
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header citas py-2">
                <small class="fw-semibold">Modifica los datos de la cita</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Cita.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cita.MascotaId" class="form-label"></label>
                            <select asp-for="Cita.MascotaId"
                                    asp-items="Model.MascotasLista"
                                    class="form-select">
                                <option value="">-- Selecciona una mascota --</option>
                            </select>
                            <span asp-validation-for="Cita.MascotaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cita.VeterinarioId" class="form-label"></label>
                            <select asp-for="Cita.VeterinarioId"
                                    asp-items="Model.VeterinariosLista"
                                    class="form-select">
                                <option value="">-- Selecciona un veterinario --</option>
                            </select>
                            <span asp-validation-for="Cita.VeterinarioId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cita.FechaHora" class="form-label"></label>
                        <input asp-for="Cita.FechaHora" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Cita.FechaHora" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cita.Motivo" class="form-label"></label>
                        <textarea asp-for="Cita.Motivo" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Cita.Motivo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cita.Estado" class="form-label"></label>
                        <select asp-for="Cita.Estado"
                                asp-items="Html.GetEnumSelectList<EstadoCita>()"
                                class="form-select">
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Cita.Diagnostico" class="form-label"></label>
                        <textarea asp-for="Cita.Diagnostico" class="form-control" rows="3"
                                  placeholder="Diagnóstico (opcional)..."></textarea>
                        <span asp-validation-for="Cita.Diagnostico" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-pastel-rosa">
                            <i class="bi bi-floppy-fill me-1"></i>Guardar cambios
                        </button>
                        <a asp-page="Index" class="btn btn-pastel-lila">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
