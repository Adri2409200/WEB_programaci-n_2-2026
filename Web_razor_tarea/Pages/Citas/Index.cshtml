@page
@model Web_razor_tarea.Pages.Citas.IndexModel
@using Web_razor_tarea.Models
@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-calendar2-heart-fill me-2"></i>Citas
    </h2>
    <a asp-page="Create" class="btn btn-pastel-rosa">
        <i class="bi bi-plus-circle-fill me-1"></i>Nueva Cita
    </a>
</div>

<!-- Buscador + filtro de estado -->
<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-12 col-md-7">
            <div class="input-group">
                <span class="input-group-text" style="background:var(--rosa-claro); border-color:var(--rosa);">
                    <i class="bi bi-search" style="color:var(--texto-suave);"></i>
                </span>
                <input type="text" name="Busqueda" value="@Model.Busqueda"
                       class="form-control" placeholder="Buscar por mascota, veterinario o motivo..." />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <select name="FiltroEstado" class="form-select">
                <option value="">-- Todos los estados --</option>
                @foreach (var estado in Enum.GetValues<EstadoCita>())
                {
                    <option value="@estado" selected="@(Model.FiltroEstado == estado.ToString())">
                        @estado
                    </option>
                }
            </select>
        </div>
        <div class="col-6 col-md-1">
            <button type="submit" class="btn btn-pastel-rosa w-100">Filtrar</button>
        </div>
        <div class="col-6 col-md-1">
            @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.FiltroEstado))
            {
                <a asp-page="Index" class="btn btn-pastel-lila w-100">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header citas py-2 d-flex justify-content-between align-items-center">
        <small class="fw-semibold">Citas registradas (más recientes primero)</small>
        <small class="text-muted">@Model.Citas.Count resultado(s)</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-pastel table-hover mb-0">
                <thead>
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Mascota</th>
                        <th>Veterinario</th>
                        <th>Motivo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Citas)
                    {
                        <tr>
                            <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Mascota?.Nombre</td>
                            <td>@item.Veterinario?.Nombre @item.Veterinario?.Apellidos</td>
                            <td>
                                @(item.Motivo.Length > 40 ? item.Motivo[..40] + "…" : item.Motivo)
                            </td>
                            <td class="text-center">
                                @switch (item.Estado)
                                {
                                    case EstadoCita.Pendiente:
                                        <span class="badge badge-pendiente rounded-pill px-3">Pendiente</span>
                                        break;
                                    case EstadoCita.Completada:
                                        <span class="badge badge-completada rounded-pill px-3">Completada</span>
                                        break;
                                    case EstadoCita.Cancelada:
                                        <span class="badge badge-cancelada rounded-pill px-3">Cancelada</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <a asp-page="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-cielo me-1" title="Ver detalle">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-lila me-1" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-rosa" title="Eliminar">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Citas.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No se encontraron citas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
