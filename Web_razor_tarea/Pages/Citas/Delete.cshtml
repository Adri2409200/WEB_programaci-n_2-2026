@page
@model Web_razor_tarea.Pages.Citas.DeleteModel
@using Web_razor_tarea.Models
@{
    ViewData["Title"] = "Eliminar Cita";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-rosa me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0" style="border-left-color: #f7c5d5;">
        <i class="bi bi-trash3-fill me-2"></i>Eliminar Cita
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header citas py-2">
                <small class="fw-semibold">¿Confirmas que deseas eliminar esta cita?</small>
            </div>
            <div class="card-body">
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Esta acción no se puede deshacer.
                </div>

                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Mascota</dt>
                    <dd class="col-7">@Model.Cita.Mascota?.Nombre</dd>

                    <dt class="col-5 text-muted">Veterinario</dt>
                    <dd class="col-7">
                        Dr(a). @Model.Cita.Veterinario?.Nombre @Model.Cita.Veterinario?.Apellidos
                    </dd>

                    <dt class="col-5 text-muted">Fecha y Hora</dt>
                    <dd class="col-7">@Model.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5 text-muted">Motivo</dt>
                    <dd class="col-7">@Model.Cita.Motivo</dd>

                    <dt class="col-5 text-muted">Estado</dt>
                    <dd class="col-7">@Model.Cita.Estado</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent border-0">
                <form method="post" class="d-flex gap-2">
                    <button type="submit" class="btn btn-pastel-rosa">
                        <i class="bi bi-trash3-fill me-1"></i>Sí, eliminar
                    </button>
                    <a asp-page="Index" class="btn btn-pastel-lila">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
