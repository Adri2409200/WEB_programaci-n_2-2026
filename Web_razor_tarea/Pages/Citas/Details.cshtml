@page
@model Web_razor_tarea.Pages.Citas.DetailsModel
@using Web_razor_tarea.Models
@{
    ViewData["Title"] = "Detalle de Cita";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-rosa me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-calendar2-heart-fill me-2"></i>Detalle de Cita
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="card">
            <div class="card-header citas py-2 d-flex justify-content-between align-items-center">
                <span class="fw-semibold">
                    @Model.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")
                </span>
                @switch (Model.Cita.Estado)
                {
                    case EstadoCita.Pendiente:
                        <span class="badge badge-pendiente rounded-pill px-3">Pendiente</span>
                        break;
                    case EstadoCita.Completada:
                        <span class="badge badge-completada rounded-pill px-3">Completada</span>
                        break;
                    case EstadoCita.Cancelada:
                        <span class="badge badge-cancelada rounded-pill px-3">Cancelada</span>
                        break;
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Mascota</dt>
                    <dd class="col-7">@Model.Cita.Mascota?.Nombre</dd>

                    <dt class="col-5 text-muted">Veterinario</dt>
                    <dd class="col-7">
                        Dr(a). @Model.Cita.Veterinario?.Nombre @Model.Cita.Veterinario?.Apellidos
                    </dd>

                    <dt class="col-5 text-muted">Fecha y Hora</dt>
                    <dd class="col-7">@Model.Cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5 text-muted">Motivo</dt>
                    <dd class="col-7">@Model.Cita.Motivo</dd>

                    <dt class="col-5 text-muted">Estado</dt>
                    <dd class="col-7">@Model.Cita.Estado</dd>

                    <dt class="col-5 text-muted">Diagnóstico</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.Cita.Diagnostico))
                        {
                            @Model.Cita.Diagnostico
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Sin diagnóstico aún</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Cita.Id" class="btn btn-pastel-lila">
                    <i class="bi bi-pencil-fill me-1"></i>Editar
                </a>
                <a asp-page="Delete" asp-route-id="@Model.Cita.Id" class="btn btn-pastel-rosa">
                    <i class="bi bi-trash3-fill me-1"></i>Eliminar
                </a>
            </div>
        </div>
    </div>
</div>
