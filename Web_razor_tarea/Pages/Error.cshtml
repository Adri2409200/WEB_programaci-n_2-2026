@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-4 mb-4 rounded-4"
     style="background: linear-gradient(135deg, #fde8ef 0%, #e8dffc 100%);
            box-shadow: 0 4px 18px rgba(160,130,200,0.18);">
    <div class="mb-3">
        <i class="bi bi-exclamation-circle-fill" style="font-size:3.5rem; color:#f7c5d5;"></i>
    </div>
    <h1 class="fw-bold mb-1" style="color:#4a4063;">Ocurrió un error</h1>
    <p class="mb-0" style="color:#7a6f8a;">
        Algo salió mal al procesar tu solicitud.
    </p>
</div>

@if (Model.ShowRequestId)
{
    <div class="row justify-content-center mb-3">
        <div class="col-12 col-md-8">
            <div class="alert alert-warning">
                <i class="bi bi-hash me-1"></i>
                <strong>ID de solicitud:</strong>
                <code>@Model.RequestId</code>
            </div>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header default py-2">
                <small class="fw-semibold">
                    <i class="bi bi-info-circle me-1"></i>¿Qué puedes hacer?
                </small>
            </div>
            <div class="card-body">
                <ul class="mb-3" style="color:#7a6f8a;">
                    <li>Recarga la página e intenta de nuevo.</li>
                    <li>Regresa al inicio y repite la acción.</li>
                    <li>Si el problema persiste, contacta al administrador.</li>
                </ul>
                <a asp-page="/Index" class="btn btn-pastel-lila">
                    <i class="bi bi-house-heart-fill me-1"></i>Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
