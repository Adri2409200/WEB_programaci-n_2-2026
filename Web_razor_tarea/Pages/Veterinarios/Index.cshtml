@page
@model Web_razor_tarea.Pages.Veterinarios.IndexModel
@{
    ViewData["Title"] = "Veterinarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-person-badge-fill me-2"></i>Veterinarios
    </h2>
    <a asp-page="Create" class="btn btn-pastel-cielo">
        <i class="bi bi-person-plus-fill me-1"></i>Nuevo Veterinario
    </a>
</div>

<div class="card">
    <div class="card-header veterinarios py-2">
        <small class="fw-semibold">Equipo médico registrado</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-pastel table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>Especialidad</th>
                        <th>Teléfono</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Veterinarios)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Apellidos</td>
                            <td>@item.Especialidad</td>
                            <td>@item.Telefono</td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge badge-activo rounded-pill px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo rounded-pill px-3">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-page="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-cielo me-1" title="Ver detalle">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-lila me-1" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-pastel-rosa" title="Eliminar">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Veterinarios.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No hay veterinarios registrados aún.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
