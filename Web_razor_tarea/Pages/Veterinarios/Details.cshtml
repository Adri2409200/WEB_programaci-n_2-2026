@page
@model Web_razor_tarea.Pages.Veterinarios.DetailsModel
@{
    ViewData["Title"] = "Detalle del Veterinario";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-cielo me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-person-badge-fill me-2"></i>Detalle del Veterinario
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header veterinarios py-2">
                <span class="fw-semibold">
                    Dr(a). @Model.Veterinario.Nombre @Model.Veterinario.Apellidos
                </span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Nombre</dt>
                    <dd class="col-7">@Model.Veterinario.Nombre</dd>

                    <dt class="col-5 text-muted">Apellidos</dt>
                    <dd class="col-7">@Model.Veterinario.Apellidos</dd>

                    <dt class="col-5 text-muted">Especialidad</dt>
                    <dd class="col-7">@Model.Veterinario.Especialidad</dd>

                    <dt class="col-5 text-muted">Teléfono</dt>
                    <dd class="col-7">@Model.Veterinario.Telefono</dd>

                    <dt class="col-5 text-muted">Estado</dt>
                    <dd class="col-7">
                        @if (Model.Veterinario.Activo)
                        {
                            <span class="badge badge-activo rounded-pill px-3">Activo</span>
                        }
                        else
                        {
                            <span class="badge badge-inactivo rounded-pill px-3">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Veterinario.Id" class="btn btn-pastel-cielo">
                    <i class="bi bi-pencil-fill me-1"></i>Editar
                </a>
                <a asp-page="Delete" asp-route-id="@Model.Veterinario.Id" class="btn btn-pastel-rosa">
                    <i class="bi bi-trash3-fill me-1"></i>Eliminar
                </a>
            </div>
        </div>
    </div>
</div>
