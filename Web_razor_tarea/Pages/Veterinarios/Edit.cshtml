@page
@model Web_razor_tarea.Pages.Veterinarios.EditModel
@{
    ViewData["Title"] = "Editar Veterinario";
}

<div class="d-flex align-items-center mb-3">
    <a asp-page="Index" class="btn btn-sm btn-pastel-cielo me-3">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
    <h2 class="titulo-pagina mb-0">
        <i class="bi bi-pencil-fill me-2"></i>Editar Veterinario
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header veterinarios py-2">
                <small class="fw-semibold">Modifica los datos del veterinario</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Veterinario.Id" />

                    <div class="mb-3">
                        <label asp-for="Veterinario.Nombre" class="form-label"></label>
                        <input asp-for="Veterinario.Nombre" class="form-control" />
                        <span asp-validation-for="Veterinario.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Veterinario.Apellidos" class="form-label"></label>
                        <input asp-for="Veterinario.Apellidos" class="form-control" />
                        <span asp-validation-for="Veterinario.Apellidos" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Veterinario.Especialidad" class="form-label"></label>
                        <input asp-for="Veterinario.Especialidad" class="form-control" />
                        <span asp-validation-for="Veterinario.Especialidad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Veterinario.Telefono" class="form-label"></label>
                        <input asp-for="Veterinario.Telefono" class="form-control" />
                        <span asp-validation-for="Veterinario.Telefono" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="Veterinario.Activo" class="form-check-input" />
                            <label asp-for="Veterinario.Activo" class="form-check-label">Activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-pastel-cielo">
                            <i class="bi bi-floppy-fill me-1"></i>Guardar cambios
                        </button>
                        <a asp-page="Index" class="btn btn-pastel-rosa">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
