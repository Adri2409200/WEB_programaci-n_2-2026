<!DOCTYPE html>
<html lang="es" style="height:100%;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UPV</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC_trabajo.styles.css" asp-append-version="true" />
</head>
@{
    var rol = Context.Session.GetString("UsuarioRol");
    var claseRol = rol == "Administrador" ? "rol-admin"
                 : rol == "Bibliotecario"  ? "rol-bibliotecario"
                 : "rol-usuario";
}
<body class="@claseRol">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm navbar-dark border-bottom">
        <div class="container-fluid px-3">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                📚 Biblioteca UPV
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (!string.IsNullOrEmpty(rol))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>

                        @if (rol == "Administrador" || rol == "Bibliotecario")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a>
                            </li>
                        }
                        @if (rol == "Administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                        }
                        @if (rol == "Usuario")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Libros" asp-action="Index">Catálogo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Prestamos" asp-action="MisPrestamos">Mis Préstamos</a>
                            </li>
                        }
                    }
                </ul>

                @if (!string.IsNullOrEmpty(rol))
                {
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="nav-link nav-usuario">
                                👤 @Context.Session.GetString("UsuarioNombre")
                                <span class="nav-rol-badge">@rol</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-salir" asp-controller="Account" asp-action="Logout">
                                🚪 Salir
                            </a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <div class="contenido-principal">
        <div class="container-fluid px-4 py-3">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-principal">
        <span>&copy; 2026 · Biblioteca UPV · Universidad Privada del Valle, Sede Sucre</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
