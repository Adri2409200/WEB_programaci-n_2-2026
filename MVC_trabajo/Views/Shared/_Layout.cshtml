<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UPV</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC_trabajo.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    Biblioteca UPV
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @{
                            var rol = Context.Session.GetString("UsuarioRol");
                        }

                        @if (!string.IsNullOrEmpty(rol))
                        {
                            <!-- Dashboard siempre visible si está logueado -->
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>

                            @if (rol == "Administrador" || rol == "Bibliotecario")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Libros" asp-action="Index">Libros</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Prestamos" asp-action="Index">Préstamos</a>
                                </li>
                            }

                            @if (rol == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                                </li>
                            }

                            @if (rol == "Usuario")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Libros" asp-action="Index">Catálogo</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Prestamos" asp-action="MisPrestamos">Mis Préstamos</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Nombre del usuario y botón cerrar sesión -->
                    @if (!string.IsNullOrEmpty(rol))
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    @Context.Session.GetString("UsuarioNombre") (@rol)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">Salir</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center py-2">
            &copy; 2026 - Biblioteca UPV - Universidad Privada del Valle, Sede Sucre
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
