@model IEnumerable<MVC_trabajo.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
    var rol = Context.Session.GetString("UsuarioRol");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">📚 Catálogo de Libros</h2>
        <p class="text-muted mb-0">Listado de libros disponibles en la biblioteca</p>
    </div>
    @if (rol == "Administrador" || rol == "Bibliotecario")
    {
        <a asp-action="Create" class="btn btn-primary px-4">+ Nuevo Libro</a>
    }
</div>

<div class="table-wrapper">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Autor</th>
                <th>ISBN</th>
                <th>Editorial</th>
                <th>Año</th>
                <th>Categoría</th>
                <th>Disponibles</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Titulo</strong></td>
                    <td>@item.Autor</td>
                    <td><small class="text-muted">@item.ISBN</small></td>
                    <td>@item.Editorial</td>
                    <td>@item.Anio</td>
                    <td>@item.Categoria</td>
                    <td>
                        <span class="badge @(item.Cantidad > 0 ? "bg-success" : "bg-danger")">
                            @item.Cantidad
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>
                        @if (rol == "Administrador" || rol == "Bibliotecario")
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        }
                        @if (rol == "Administrador")
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
