@model IEnumerable<MVC_trabajo.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
    var rol = Context.Session.GetString("UsuarioRol");
}

<h2>Catálogo de Libros</h2>

@if (rol == "Administrador" || rol == "Bibliotecario")
{
    <p>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Libro</a>
    </p>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>ISBN</th>
            <th>Editorial</th>
            <th>Año</th>
            <th>Categoría</th>
            <th>Disponibles</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.Autor</td>
                <td>@item.ISBN</td>
                <td>@item.Editorial</td>
                <td>@item.Anio</td>
                <td>@item.Categoria</td>
                <td>
                    <span class="badge @(item.Cantidad > 0 ? "bg-success" : "bg-danger")">
                        @item.Cantidad
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>

                    @if (rol == "Administrador" || rol == "Bibliotecario")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    }

                    @if (rol == "Administrador")
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
