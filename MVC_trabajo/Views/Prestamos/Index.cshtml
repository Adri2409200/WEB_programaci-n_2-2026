@model IEnumerable<MVC_trabajo.Models.Prestamo>

@{
    ViewData["Title"] = "Gestión de Préstamos";
    var rol = Context.Session.GetString("UsuarioRol");
}

<h2>Gestión de Préstamos</h2>

@if (rol == "Administrador" || rol == "Bibliotecario")
{
    <p>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Préstamo</a>
    </p>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Usuario</th>
            <th>Libro</th>
            <th>Fecha Préstamo</th>
            <th>Fecha Devolución</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Usuario?.Nombre</td>
                <td>@item.Libro?.Titulo</td>
                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (item.Estado == "Pendiente")
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else if (item.Estado == "Devuelto")
                    {
                        <span class="badge bg-success">Devuelto</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Vencido</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>

                    @if (rol == "Administrador" || rol == "Bibliotecario")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    }

                    @if (rol == "Administrador")
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
