@model IEnumerable<MVC_trabajo.Models.Prestamo>

@{
    ViewData["Title"] = "Mis Préstamos";
}

<h2>Mis Préstamos</h2>
<p class="text-muted">Listado de préstamos solicitados por ti</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No tienes préstamos registrados.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Libro</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Devolución</th>
                <th>Estado</th>
                <th>Detalle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Libro?.Titulo</td>
                    <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaDevolucion.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else if (item.Estado == "Devuelto")
                        {
                            <span class="badge bg-success">Devuelto</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Vencido</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary mt-2">Volver al Dashboard</a>
