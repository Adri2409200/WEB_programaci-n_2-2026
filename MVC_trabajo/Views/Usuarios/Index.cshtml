@model IEnumerable<MVC_trabajo.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">👥 Gestión de Usuarios</h2>
        <p class="text-muted mb-0">Administra los usuarios del sistema</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4">+ Nuevo Usuario</a>
</div>

<div class="table-wrapper">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nombre</strong></td>
                    <td><small>@item.Correo</small></td>
                    <td>
                        @if (item.Rol == "Administrador")
                        {
                            <span class="badge bg-danger">🔴 Administrador</span>
                        }
                        else if (item.Rol == "Bibliotecario")
                        {
                            <span class="badge bg-success">🟢 Bibliotecario</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">🔵 Usuario</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
