@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="mb-4">
    <h2 class="mb-1">👋 Bienvenido, @Context.Session.GetString("UsuarioNombre")</h2>
    <p class="text-muted">Panel de Administrador · Biblioteca UPV</p>
</div>

<!-- Tarjetas de estadísticas -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-azul">
            <div class="stat-icono">📚</div>
            <div class="stat-numero">@ViewBag.TotalLibros</div>
            <div class="stat-label">Total Libros</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-verde">
            <div class="stat-icono">👥</div>
            <div class="stat-numero">@ViewBag.TotalUsuarios</div>
            <div class="stat-label">Total Usuarios</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-naranja">
            <div class="stat-icono">📋</div>
            <div class="stat-numero">@ViewBag.TotalPrestamos</div>
            <div class="stat-label">Total Préstamos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-rojo">
            <div class="stat-icono">⚠️</div>
            <div class="stat-numero">@ViewBag.PrestamosVencidos</div>
            <div class="stat-label">Vencidos</div>
        </div>
    </div>
</div>

<!-- Estado de préstamos -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="info-card">
            <div class="info-card-title">Estado de Préstamos</div>
            <div class="info-item">
                <span>⏳ Pendientes</span>
                <span class="badge bg-warning text-dark">@ViewBag.PrestamosPendientes</span>
            </div>
            <div class="info-item">
                <span>✅ Devueltos</span>
                <span class="badge bg-success">@ViewBag.PrestamosDevueltos</span>
            </div>
            <div class="info-item">
                <span>❌ Vencidos</span>
                <span class="badge bg-danger">@ViewBag.PrestamosVencidos</span>
            </div>
            <div class="info-item">
                <span>📵 Sin stock</span>
                <span class="badge bg-secondary">@ViewBag.LibrosSinStock</span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="info-card">
            <div class="info-card-title">Último Registro</div>
            <div class="info-item-col">
                <small class="text-muted">👤 Último usuario</small>
                <strong>@ViewBag.UltimoUsuario</strong>
                <span class="badge bg-secondary mt-1">@ViewBag.UltimoUsuarioRol</span>
            </div>
            <hr class="my-2" />
            <div class="info-item-col">
                <small class="text-muted">📖 Último libro agregado</small>
                <strong>@ViewBag.UltimoLibro</strong>
                <small class="text-muted">@ViewBag.UltimoLibroAutor</small>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="info-card">
            <div class="info-card-title">Último Préstamo</div>
            <div class="info-item-col">
                <small class="text-muted">📗 Libro</small>
                <strong>@ViewBag.UltimoPrestamo</strong>
            </div>
            <hr class="my-2" />
            <div class="info-item-col">
                <small class="text-muted">👤 Solicitado por</small>
                <strong>@ViewBag.UltimoPrestamoUser</strong>
            </div>
            <hr class="my-2" />
            <div class="info-item-col">
                <small class="text-muted">📅 Fecha</small>
                <strong>@ViewBag.UltimoPrestamoFecha</strong>
            </div>
        </div>
    </div>
</div>

<!-- Accesos rápidos -->
<div class="row g-3">
    <div class="col-6 col-md-3">
        <a asp-controller="Libros" asp-action="Index" class="acceso-card acceso-azul">
            <span>📚</span><p>Libros</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Usuarios" asp-action="Index" class="acceso-card acceso-verde">
            <span>👥</span><p>Usuarios</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Prestamos" asp-action="Index" class="acceso-card acceso-naranja">
            <span>📋</span><p>Préstamos</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Account" asp-action="Logout" class="acceso-card acceso-rojo">
            <span>🚪</span><p>Salir</p>
        </a>
    </div>
</div>
